# Vorlage für die lokale .env: cp .env.example .env
# Die Vorgaben passen zum Einstieg in der README (eigene Datenbank im
# Container, keine weiteren Dienste). Die .env gehört nicht ins Git.

# --- Django ------------------------------------------------------------------

# Für die Entwicklung genügt der Wert unten. Für den Betrieb neu erzeugen:
#
#   uv run python -c "from django.utils.crypto import get_random_string; print(get_random_string(50, 'abcdefghijklmnopqrstuvwxyz0123456789!@#%^&*(-_=+)'))"
#
# Das Alphabet ist das von get_random_secret_key() ohne "$": docker compose
# ersetzt in dieser Datei $NAME durch Umgebungsvariablen und verstümmelt einen
# Schlüssel mit Dollarzeichen, django-environ dagegen liest ihn vollständig.
DJANGO_SECRET_KEY=dev-nur-lokal-bitte-fuer-produktion-neu-erzeugen

# Der Betriebsmodus hängt am Settings-Modul (paperwerk.settings.dev oder
# .prod); manage.py wählt dev, das Dockerfile prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Datenbank ---------------------------------------------------------------

# PostgreSQL. Passt zum Container aus der README:
#   docker run -d --name paperwerk-db -e POSTGRES_USER=paperwerk \
#     -e POSTGRES_PASSWORD=paperwerk -e POSTGRES_DB=paperwerk \
#     -p 127.0.0.1:5432:5432 postgres:18
DATABASE_URL=postgres://paperwerk:paperwerk@127.0.0.1:5432/paperwerk

# Ablage der Beleg-PDFs. Ohne Angabe media/ im Projektverzeichnis.
# Wer gegen die Datenbank eines laufenden Stacks entwickelt, gibt hier
# dasselbe Verzeichnis an, das dort unter /app/media hängt, weil die
# Datenbank nur relative Pfade speichert.
#DJANGO_MEDIA_ROOT=

# --- Name und Logo der Anwendung ---------------------------------------------
#
# Unter welchem Namen die Anwendung beim Kunden auftritt. Ohne Angabe heißt
# sie "Paper-Werk"; ein Betrieb, der anders heißen will, setzt diese Werte.
#
# Es zieht mit, was der Anwender bei der täglichen Arbeit sieht: Browsertab,
# Kopf der Seitenleiste, Anmeldeseite, die Seiten rund um die Anmeldung über
# Microsoft. Es bleibt, was nur sieht, wer die Anlage betreut: diese
# Variablennamen, die Containernamen, die Protokollzeilen, die Schnittstelle.
# Und die Gruppen paper-werk-buero/-projektleitung/-superuser bleiben
# ebenfalls: Sie heißen in Entra ID, in Paperless und hier gleich.
#
# Die Belege sind nicht betroffen; PDF, E-Rechnung und E-Mail tragen von
# jeher die Firma des Kunden aus den Stammdaten.
#
# Ausführlich: der Kopf von core/marke.py.

#PAPER_WERK_MARKE_NAME=Belegwerk

# Die kleine Zeile unter dem Namen. Ausdrücklich leer gesetzt blendet sie
# aus; ohne Angabe steht dort "Faktura, Projekte, Controlling".
#PAPER_WERK_MARKE_UNTERTITEL=

# Das Zeichen im farbigen Quadrat, solange kein Logo da ist. Ein Name aus
# Googles Material Symbols (https://fonts.google.com/icons), z. B.
# "engineering" oder "science".
#PAPER_WERK_MARKE_SYMBOL=receipt_long

# Das Logo des Betriebs. Der Pfad zählt INNERHALB des Medienordners
# (DJANGO_MEDIA_ROOT oben, im Stack das Volume unter /app/media), also
# "marke/logo.svg" für die Datei "<Medienordner>/marke/logo.svg".
#
# Nicht bei den statischen Dateien: Die sammelt "collectstatic" beim Bauen
# des Abbilds ein, eine nachträglich hineingelegte Datei bliebe dort
# unsichtbar.
#
# Es ersetzt das Quadrat; der Name steht daneben. Etwa 38 Pixel
# hoch, quadratisch. Fehlt die Datei, zeigt die Oberfläche wieder das
# Symbol; "manage.py check" sagt es dann (paperwerk.W002).
#PAPER_WERK_MARKE_LOGO=marke/logo.svg

# Eine eigene Fassung für den Dunkelmodus. Ohne Angabe gilt dieselbe Datei
# für beide; dann muss sie auf hellem wie auf dunklem Grund taugen.
#PAPER_WERK_MARKE_LOGO_DUNKEL=marke/logo-dunkel.svg

# Das Symbol im Browsertab, ebenfalls ein Pfad im Medienordner. Ohne Angabe
# das mitgelieferte SVG. Der Medientyp folgt der Dateiendung.
#PAPER_WERK_MARKE_FAVICON=marke/tab.png

# Wohin "Webseite anzeigen" im Benutzermenü des Admin führt.
#
# Ohne Angabe die Seite der KI-Werkstatt. Auf einer Kundenanlage gehört hier
# die Seite des Betriebs hin, weil der Anwender dort seine eigene erwartet.
# Leer gesetzt verschwindet der Verweis ganz.
#
# Der frühere Name PAPERWERK_WEBSEITE wird nicht mehr gelesen.
#PAPER_WERK_MARKE_WEBSEITE=https://www.ki-werkstatt.net

# --- Das Archiv (Paperless) --------------------------------------------------
# Beim Festschreiben wandert das PDF dorthin. Aus Sicht von "runserver" ist
# Paperless unter seinem veröffentlichten Port erreichbar; im Container
# heisst es paper-werk-intern "paperless:8000" (siehe .env.app im Stack).
#PAPERLESS_URL=http://localhost:8005

# Schlüssel eines Paperless-Benutzers:
#   docker exec paper-werk-paperless-1 python3 manage.py drf_create_token admin
# ACHTUNG: Ein Token überlebt das Neuaufsetzen der Paperless-Datenbank nicht.
PAPERLESS_TOKEN=

# Die Adresse, unter der ein MENSCH das Archiv im Browser öffnet. Im Container
# NICHT dieselbe wie oben: "paperless:8000" kennt nur das Compose-Netz, ein
# Verweis darauf wäre im Browser tot. Hier steht der veröffentlichte Port
# bzw. später der Name hinter dem Proxy.
PAPERLESS_ANSICHT_URL=http://localhost:8005

# Der Hauptschalter. Ohne ihn wird nichts hochgeladen, ohne Meldung.
#PAPERLESS_ARCHIVIERUNG=True

# Soll das FESTSCHREIBEN auf die Dokumentnummer aus dem Archiv warten?
#
# Aus (Vorgabe): Der Beleg wird hochgeladen, und der Anwender ist fertig -
# das Festschreiben dauert dann unter einer Sekunde. Die Dokumentnummer
# holt "manage.py belege_archivieren" nach; bis dahin steht im Admin
# "wird abgelegt".
#
# ACHTUNG: Das setzt voraus, dass dieser Lauf auch stattfindet; täglich
# genügt. Ohne ihn liegt das Dokument zwar im Archiv, aber diese Seite
# kennt seine Nummer nicht, und der Verweis vom Beleg dorthin bleibt aus.
#
# An: Der Anwender wartet, bis Paperless die Datei verarbeitet hat -
# gemessen gut drei Sekunden, höchstens PAPERLESS_WARTEZEIT. Dafür
# stimmt der Vermerk sofort und es braucht keinen Nachlauf.
#PAPERLESS_WARTEN_BEIM_FESTSCHREIBEN=True

# --- Der Postausgang ---------------------------------------------------------
# Für den Knopf "Versenden" an der Rechnung: festschreiben, PDF anhängen,
# hinausschicken. Eigenes SMTP und kein Umweg über n8n, weil ein Versand, der
# einen laufenden Workflow voraussetzt, ausfällt, sobald der steht.
#
# **Ohne EMAIL_HOST schreibt Django die Mail in die Konsole**, statt beim
# Verbindungsaufbau zu scheitern. Das ist die richtige Reihenfolge für eine
# Anlage, die gerade eingerichtet wird: Der Ablauf lässt sich vollständig
# durchspielen, bevor irgendwo Post hinausgeht.
#EMAIL_HOST=smtp.example.de
#EMAIL_PORT=587
#EMAIL_HOST_USER=rechnung@example.de
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=True

# **Nur für den Entwicklungsrechner.** Dort landet Post grundsätzlich in
# der Server-Konsole, auch mit gültigem EMAIL_HOST, damit ein Tippfehler in
# einer Testadresse keine echte Person erreicht. Wer den Weg einmal
# bis zum Postfach prüfen will, setzt zusätzlich diesen Schalter.
# Im Betrieb (prod.py) hat er keine Wirkung.
#EMAIL_ECHT_SENDEN=True

# Die Absenderadresse. Leer heisst: die aus den Firmenstammdaten. Getrennt
# einstellbar, weil manche Postausgänge nur eine bestimmte Absenderadresse
# durchlassen, und die ist nicht immer die vom Briefkopf.
#DEFAULT_FROM_EMAIL=rechnung@example.de

# Blindkopie an die eigene Firmenadresse. An (Default), weil es die Ablage
# im Postausgang ersetzt: Wer wissen will, ob eine Rechnung wirklich
# hinausging, sieht in seinem eigenen Postfach nach.
#FAKTURA_VERSAND_KOPIE=False

# PDF-Erzeugung unter Windows: Verzeichnis der GTK3-Runtime für WeasyPrint
# (https://github.com/tschoonj/GTK-for-Windows-Runtime-Environment-Installer).
# Unter Linux und macOS weglassen, dort kommt Pango aus der Paketverwaltung.
#GTK_BIN_DIR=C:\Program Files\GTK3-Runtime Win64\bin

# Einfache Passwörter zulassen (leert AUTH_PASSWORD_VALIDATORS).
#
# In der Entwicklung nicht nötig: dev.py schaltet die Regeln ohnehin ab, dort
# entstehen Wegwerfkonten zum Durchklicken. Der Schalter zählt im Container -
# dort gilt prod.py.
#
# Auf einer Anlage mit echten Daten gehört er weg. Django meldet leere
# Passwortregeln NICHT von selbst; dieses Projekt bringt dafür eine eigene
# Prüfung mit (paperwerk.W001 in "check --deploy").
# DJANGO_EINFACHE_PASSWOERTER=True

# Darf "manage.py seed_faktura" hier laufen?
#
# In der Entwicklung nicht nötig: Dort gilt DEBUG=True, und damit ist das
# Seeden ohnehin erlaubt. Der Schalter zählt im Container; dort läuft
# immer paperwerk.settings.prod mit DEBUG=False, auch im Teststack. Eine
# Sperre allein an DEBUG würde also ausgerechnet die eine Installation
# aussperren, die den Befehl gebrauchen darf.
#
# Auf einer produktiven Anlage bleibt er aus: seed_faktura schreibt Belege
# fest und zieht dabei echte Nummern aus dem lückenlosen Kreis.
# FAKTURA_DEMODATEN_ERLAUBT=True

# ---------------------------------------------------------------------------
# Nur für den Betrieb (paperwerk.settings.prod); in der Entwicklung
# unbenutzt. Hier aufgeführt, damit sie nicht erst im Fehlerfall auffallen.
# ---------------------------------------------------------------------------

# Herkünfte, denen bei POST vertraut wird. Muss die Adresse enthalten, unter
# der die Anwendung tatsächlich erreichbar ist, hinter einem Reverse Proxy
# also dessen Namen. Fehlt sie, scheitert jedes Speichern im Admin mit
# "CSRF verification failed", und zwar erst nach der Anmeldung.
#DJANGO_CSRF_TRUSTED_ORIGINS=https://paper-werk.local

# Cookies nur über HTTPS. Im lokalen Netz ohne Zertifikat auf False setzen,
# sonst kommt keine Anmeldung zustande, weil der Browser das Cookie dann
# gar nicht erst zurücksendet.
#DJANGO_COOKIE_SECURE=True

# Jede Anfrage auf HTTPS umleiten. Default False, und das ist eine bewusste
# Entscheidung gegen Djangos Empfehlung: Ohne erreichbares HTTPS erzeugt True
# eine Umleitungsschleife, und die Anwendung ist nicht erreichbar.
# Wer TLS hat, setzt es auf True; dann verstummt auch die
# Warnung security.W008.
#DJANGO_SSL_REDIRECT=True

# HSTS-Dauer in Sekunden. 0 heisst aus, und das ist der Default aus gutem
# Grund: Ein ausgelieferter Wert lässt sich beim Besucher nicht mehr
# zurücknehmen. Siehe Kommentar in paperwerk/settings/prod.py.
#DJANGO_HSTS_SEKUNDEN=0

# --- Gemeinsame Anmeldung (OIDC, z. B. Microsoft Entra ID) -------------------
#
# EIN ANGEBOT, kein Muss: Ohne SSO_CLIENT_ID gibt es keinen Knopf, und die
# Anwendung verhält sich wie bisher. Das Anmeldeformular des Admin bleibt
# auch MIT Anbieter stehen; es ist der Notfallweg, wenn das Verzeichnis
# nicht antwortet.
#
# Die Rückleitadresse, die im Portal eingetragen sein muss:
#   <adresse-der-app>/accounts/oidc/<SSO_PROVIDER_ID>/login/callback/
# Mit Paperless kann es DIESELBE App-Registrierung sein (zwei
# Rückleitadressen, ein Geheimnis). Die App-Rollen heissen wie die Gruppen
# in beiden Anwendungen: paper-werk-buero, paper-werk-projektleitung,
# paper-werk-superuser (siehe core/gruppen.py in paper-werk-app).
#
# ACHTUNG, Dollarzeichen im Clientschlüssel: Compose deutet $ auch in
# env_file-Dateien als Variable und verstümmelt den Wert still. Steht eines
# darin, im Portal einen neuen Schlüssel erzeugen.
SSO_PROVIDER_ID=entra
SSO_NAME=Microsoft
SSO_SERVER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
SSO_CLIENT_ID=
SSO_SECRET=
# Das Protokoll, mit dem die Rückleitadresse GEBAUT wird. https ist der
# Default und richtig, sobald TLS davor steht; ohne TLS muss hier http stehen.
SSO_HTTP_PROTOKOLL=http
