# Eigene deutsche Übersetzungen, die Djangos mitgelieferte überschreiben.
#
# Diese Datei ist KEINE Kopie von Djangos django.po. Sie enthält nur die
# Einträge, die anders lauten sollen. Alles Übrige kommt weiterhin aus
# Django selbst; dank LOCALE_PATHS wird diese Datei zuletzt geladen und
# gewinnt bei gleicher msgid.
#
# Nach jeder Änderung:  uv run python manage.py compilemessages
# Der Server liest nur die erzeugte django.mo, und nur beim Start.
#
msgid ""
msgstr ""
"Project-Id-Version: paper-werk-app\n"
"Report-Msgid-Bugs-To: \n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Djangos Übersetzung lautet "Geschichte". Gemeint ist das Änderungs-
# protokoll eines Datensatzes; "Verlauf" trifft das, "Geschichte" klingt
# nach Erzählung.
#
# Der Knopf oben rechts in jeder Änderungsansicht:
msgid "History"
msgstr "Verlauf"

# Die Überschrift der Protokollseite (Djangos Fassung: "Änderungsgeschichte: %s"):
msgid "Change history: %s"
msgstr "Änderungsverlauf: %s"

# Der Hinweis, wenn zu einem Datensatz nichts protokolliert ist. Achtung:
# die msgid muss zeichengenau mit Djangos Original übereinstimmen; sie
# enthält typografische Apostrophe (U+2019), keine geraden.
msgid ""
"This object doesn’t have a change history. It probably wasn’t added via this "
"admin site."
msgstr ""
"Zu diesem Datensatz ist kein Verlauf vorhanden. Er wurde vermutlich nicht "
"über diese Verwaltungsseiten angelegt."

# ---------------------------------------------------------------------------
# Unfold (django-unfold 0.108.0)
#
# Unfold bringt keine deutsche Übersetzung mit. Ohne diesen Abschnitt stehen
# in einer sonst deutschen Oberfläche "Type to search", "Welcome back to",
# "Return to site" und rund fünfzig weitere Texte.
#
# Erzeugt mit makemessages über eine Kopie von Unfold, dann nur die
# Einträge übernommen, die weder Django noch diese Datei schon übersetzen.
# Die msgids sind zeichengenau übernommen (Leerzeichen, typografische
# Apostrophe); eine einzige Abweichung, und der Text bleibt englisch.
#
# Nach einem Unfold-Update: dasselbe Verfahren wiederholen, siehe
# core/tests/test_oberflaeche_deutsch.py.
# ---------------------------------------------------------------------------

